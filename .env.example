# Variáveis de Ambiente — Divisor de PDFs
# Copie este arquivo para .env e ajuste os valores

SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis — controla cache/sessão (django_redis) E o broker/result do Celery.
# IMPORTANTE: use um número de DB EXCLUSIVO deste app. Vários apps no mesmo
# servidor não podem compartilhar o mesmo DB + fila padrão "celery", senão os
# workers roubam tarefas uns dos outros (NotRegistered) e os jobs travam.
# Alocação neste servidor: divisor_pdf=1, sistema_questoes=2, sistema_vetorial=0.
REDIS_URL=redis://localhost:6379/1

# PostgreSQL (produção) — usado apenas por config.settings.production
DB_NAME=divisor_pdf
DB_USER=divisor_pdf
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Upload limits
MAX_UPLOAD_SIZE_MB=500
MAX_TOTAL_UPLOAD_MB=2048

# Ghostscript
GHOSTSCRIPT_TIMEOUT_SECONDS=300

# OCR (OCRmyPDF + Tesseract). Reconhecer texto custa segundos por página, daí o
# tempo limite bem maior que o do Ghostscript. OCR_JOBS é o paralelismo por
# arquivo — não passe do número de núcleos da máquina.
OCR_TIMEOUT_SECONDS=1800
OCR_JOBS=2
# OCRMYPDF_BINARY=/usr/bin/ocrmypdf

# Session / cleanup
SESSION_EXPIRY_SECONDS=3600
CLEANUP_INTERVAL_MINUTES=15
